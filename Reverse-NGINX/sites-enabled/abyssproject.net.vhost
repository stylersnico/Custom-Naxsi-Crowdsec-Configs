server {
    listen 443 ssl;
        http2 on;
        server_name www.abyssproject.net abyssproject.net;
        ssl_certificate /etc/letsencrypt/live/abyssproject.net/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/abyssproject.net/privkey.pem;

        error_log /var/log/nginx/abyssproject.net/error.log;
        NaxsiLogFile /var/log/nginx/abyssproject.net/naxsi_error.log;
        access_log /var/log/nginx/abyssproject.net/access.log combined;
        limit_conn conn_abyssproject_net 500;

        # wordpress_block.rules (MainRule) is loaded globally in nginx.conf
        # (MainRule is only valid at http level). CheckRule "$ATTACK/$UWA
        # >= 8" BLOCK; below is what actually enforces it for this vhost.

        include /usr/local/etc/nginx/naxsi/naxsi_denied.conf;

        # Block direct access to sensitive files regardless of backend config.
        location ~* /(wp-config\.php|xmlrpc\.php~|readme\.html|license\.txt|wp-config-sample\.php)$ {
            deny all;
        }
        location ~* \.(sql|bak|log|env|ini|swp)$ {
            deny all;
        }

        # Stricter rate limit on the two brute-force-prone entry points.
        location = /wp-login.php {
            limit_req zone=login burst=20 nodelay;

            SecRulesEnabled;
            CheckRule "$SQL >= 8" BLOCK;
            CheckRule "$RFI >= 8" BLOCK;
            CheckRule "$TRAVERSAL >= 4" BLOCK;
            CheckRule "$EVADE >= 4" BLOCK;
            CheckRule "$UPLOAD >= 8" BLOCK;
            CheckRule "$XSS >= 8" BLOCK;
            CheckRule "$ATTACK >= 8" BLOCK;
            include /usr/local/etc/nginx/naxsi/wordpress_whitelist.rules;
            include /usr/local/etc/nginx/naxsi/wordpress_extra_whitelist.rules;

            client_max_body_size 512M;
            proxy_ssl_server_name on;
            proxy_ssl_session_reuse on;
            proxy_pass https://192.168.1.10:443;
            proxy_set_header Connection $http_connection;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = /xmlrpc.php {
            limit_req zone=login burst=20 nodelay;

            # XML-RPC bodies are legitimate XML (full of "<"/">"), which
            # trips the generic SQL/XSS/RFI/TRAVERSAL/EVADE/UPLOAD scoring
            # almost instantly. Only apply the targeted attack-pattern
            # blocklist (brute-force/enumeration method calls) here.
            SecRulesEnabled;
            CheckRule "$ATTACK >= 8" BLOCK;

            client_max_body_size 512M;
            proxy_ssl_server_name on;
            proxy_ssl_session_reuse on;
            proxy_pass https://192.168.1.10:443;
            proxy_set_header Connection $http_connection;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # WP core's own JS/CSS batch-loading endpoints, hit on every
        # wp-admin page load. Their load[chunk_N] value is a WP-generated
        # list of every installed plugin's script/style handles -
        # unenumerable, changes as plugins are added/removed, and not
        # attacker-reachable content worth scanning (wp-admin only,
        # already behind auth). Naxsi bypassed entirely here rather than
        # whitelisted field-by-field.
        location ~ ^/wp-admin/load-(styles|scripts)\.php$ {
            client_max_body_size 512M;
            proxy_ssl_server_name on;
            proxy_ssl_session_reuse on;
            proxy_pass https://192.168.1.10:443;
            proxy_set_header Connection $http_connection;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location / {
        client_max_body_size 512M;

        # Naxsi WAF - core rules + community-validated WordPress whitelist/blocklist.
        SecRulesEnabled;
        CheckRule "$SQL >= 8" BLOCK;
        CheckRule "$RFI >= 8" BLOCK;
        CheckRule "$TRAVERSAL >= 4" BLOCK;
        CheckRule "$EVADE >= 4" BLOCK;
        CheckRule "$UPLOAD >= 8" BLOCK;
        CheckRule "$XSS >= 8" BLOCK;
        CheckRule "$ATTACK >= 8" BLOCK;
        CheckRule "$UWA >= 8" BLOCK;
        include /usr/local/etc/nginx/naxsi/wordpress_whitelist.rules;
        include /usr/local/etc/nginx/naxsi/wordpress_extra_whitelist.rules;

                proxy_ssl_server_name on;
        proxy_ssl_session_reuse on;
        proxy_pass https://192.168.1.10:443;
        proxy_set_header Connection $http_connection;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
