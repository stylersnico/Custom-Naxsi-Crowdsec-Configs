# Home Assistant naxsi whitelist - hand-written, NOT a community-
# maintained ruleset (none exists for Home Assistant). Scoped narrowly
# to fix confirmed false positives from real traffic in
# naxsi_error.log; only extend when a new false positive is confirmed
# there, not speculatively.

# Preventive (not log-confirmed): a WAF should never content-scan a
# password field - HA's login flow API uses a JSON "password" field.
# Same reasoning as the other password-field fixes.
BasicRule wl:0 "mz:$BODY_VAR:password";

# Preventive: session cookies with heavily percent-encoded tokens trip
# the "double encoding" rule (1315) in the Cookie header - confirmed
# happening on Nextcloud and CheckMK. Same fix, applied ahead of time.
BasicRule wl:1000,1001,1005,1007,1010,1011,1013,1100,1101,1200,1308,1309,1310,1311,1315 "mz:$HEADERS_VAR:cookie";

# /auth/token's "client_id" is HA's OAuth2 client identifier, which is
# the frontend's own full URL (e.g. "https://ha-home.nicolas-simond.ch/")
# - trips the RFI scheme-detection rules (1100/1101), same false
# positive as WordPress's/Umami's "url" fields.
BasicRule wl:1100,1101 "mz:$BODY_VAR:client_id";
