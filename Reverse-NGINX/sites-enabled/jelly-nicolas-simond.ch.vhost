server {
        listen 443 ssl;
#        listen 443 quic;
        http2 on;
  server_name jelly.nicolas-simond.ch;
        ssl_certificate /etc/letsencrypt/live/nicolas-simond.ch/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/nicolas-simond.ch/privkey.pem;
  error_log /var/log/nginx/jelly.nicolas-simond.ch/error.log;
  NaxsiLogFile /var/log/nginx/jelly.nicolas-simond.ch/naxsi_error.log;
  access_log /var/log/nginx/jelly.nicolas-simond.ch/access.log combined;
  # Higher than other vhosts: HLS/DASH segment streaming (especially
  # with multiple devices/transcodes) opens many more concurrent
  # short-lived requests than a typical web app.
  limit_conn conn_jellyfin 800;
  client_max_body_size 40M;
  server_tokens off;

  include /usr/local/etc/nginx/naxsi/naxsi_denied.conf;

# Naxsi only runs on the login endpoint below (the one real
# unauthenticated attack surface) - same "login only" model as
# CheckMK/Grafana/Home Assistant/Passbolt, applied here preemptively
# rather than scanning media streaming traffic (which naxsi has no
# business inspecting anyway).
location = /jellyfin/Users/AuthenticateByName {
    limit_req zone=login burst=20 nodelay;

    SecRulesEnabled;
    CheckRule "$SQL >= 8" BLOCK;
    CheckRule "$RFI >= 8" BLOCK;
    CheckRule "$TRAVERSAL >= 4" BLOCK;
    CheckRule "$EVADE >= 4" BLOCK;
    CheckRule "$UPLOAD >= 8" BLOCK;
    CheckRule "$XSS >= 8" BLOCK;
    include /usr/local/etc/nginx/naxsi/jellyfin_whitelist.rules;

    proxy_pass http://192.168.1.17:8096;
    proxy_pass_request_headers on;
    proxy_set_header Host $proxy_host;
    proxy_http_version 1.1;
    proxy_set_header X-Real-IP              $remote_addr;
    proxy_set_header X-Forwarded-For        $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto      $scheme;
    proxy_set_header X-Forwarded-Protocol   $scheme;
    proxy_set_header X-Forwarded-Host       $http_host;
    proxy_set_header Upgrade                $http_upgrade;
    proxy_set_header Connection             $http_connection;
    proxy_set_header X-Forwarded-Ssl        on;
    proxy_redirect                          off;
    proxy_buffering                         off;
    auth_basic                              off;
}

location /jellyfin {
proxy_pass http://192.168.1.17:8096;
#
proxy_pass_request_headers on;
#
proxy_set_header Host $proxy_host;
#
proxy_http_version 1.1;
#
proxy_set_header X-Real-IP              $remote_addr;
proxy_set_header X-Forwarded-For        $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto      $scheme;
proxy_set_header X-Forwarded-Protocol   $scheme;
proxy_set_header X-Forwarded-Host       $http_host;
#
proxy_set_header Upgrade                $http_upgrade;
proxy_set_header Connection             $http_connection;
#
proxy_set_header X-Forwarded-Ssl        on;
#
proxy_redirect                          off;
proxy_buffering                         off;
auth_basic                              off;
}

}
