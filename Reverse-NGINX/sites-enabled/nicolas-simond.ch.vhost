server {
    listen 443 ssl;
        http2 on;
    server_name www.nicolas-simond.ch nicolas-simond.ch;

    # SSL configuration...
        ssl_certificate /etc/letsencrypt/live/nicolas-simond.ch/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/nicolas-simond.ch/privkey.pem;

        error_log /var/log/nginx/nicolas-simond.ch/error.log;
        NaxsiLogFile /var/log/nginx/nicolas-simond.ch/naxsi_error.log;
        access_log /var/log/nginx/nicolas-simond.ch/access.log combined;
        limit_conn conn_nicolas_simond_ch 500;

        # Static HTML site: no forms, no uploads - keep methods minimal.
        if ($request_method !~ ^(GET|HEAD)$) {
            return 405;
        }

        include /usr/local/etc/nginx/naxsi/naxsi_denied.conf;

        location / {
        client_max_body_size 1M;

        # Naxsi WAF - core rules only, standard thresholds.
        # DeniedUrl is inherited from the shared definition in nginx.conf.
        SecRulesEnabled;
        CheckRule "$SQL >= 8" BLOCK;
        CheckRule "$RFI >= 8" BLOCK;
        CheckRule "$TRAVERSAL >= 4" BLOCK;
        CheckRule "$EVADE >= 4" BLOCK;
        CheckRule "$UPLOAD >= 8" BLOCK;
        CheckRule "$XSS >= 8" BLOCK;
        include /usr/local/etc/nginx/naxsi/nicolas_simond_ch_whitelist.rules;

		proxy_ssl_server_name on;
        proxy_ssl_session_reuse on;
        proxy_pass https://192.168.1.10:443;
        proxy_set_header Connection $http_connection;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
