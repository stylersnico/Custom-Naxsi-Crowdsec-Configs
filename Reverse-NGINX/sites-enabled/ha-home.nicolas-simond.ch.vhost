    upstream homeassistant {
        server 192.168.1.11:8123;
        keepalive 64;
    }

#map $http_upgrade $connection_upgrade {
#    default upgrade;
#    ''      close;
#}

server {
        listen 443 ssl;
#        listen 443 quic;
        http2 on;
#        http3 on;

        # Enable QUIC and HTTP/3
#        add_header Alt-Svc 'h3=":$server_port"; ma=86400';

    # Update this line to be your domain
    server_name ha-home.nicolas-simond.ch;

    # Ensure these lines point to your SSL certificate and key
#    ssl_certificate /root/.acme.sh/ha-home.nicolas-simond.ch_ecc/fullchain.cer;
#    ssl_certificate_key /root/.acme.sh/ha-home.nicolas-simond.ch_ecc/ha-home.nicolas-simond.ch.key;

        ssl_certificate /etc/letsencrypt/live/nicolas-simond.ch/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/nicolas-simond.ch/privkey.pem;

    error_log /var/log/nginx/ha-home.nicolas-simond.ch/error.log;
    NaxsiLogFile /var/log/nginx/ha-home.nicolas-simond.ch/naxsi_error.log;
    access_log /var/log/nginx/ha-home.nicolas-simond.ch/access.log combined;
    limit_conn conn_ha 500;

    include /usr/local/etc/nginx/naxsi/naxsi_denied.conf;

    proxy_buffering off;

        # HA's auth flow (login_flow, token exchange, ...) is the one
        # real unauthenticated attack surface - naxsi runs only here.
        # Everything else under location / requires a valid session
        # already and includes the automation/template editor's Jinja2
        # syntax ({{ states('x') | float }}, heavy on braces/pipes/
        # quotes) - exactly the kind of structured data that caused
        # repeated whack-a-mole false positives on CheckMK, so bypassed
        # here preemptively instead of waiting for the same to happen.
        location ~ ^/auth/ {
            limit_req zone=login burst=20 nodelay;

            SecRulesEnabled;
            CheckRule "$SQL >= 8" BLOCK;
            CheckRule "$RFI >= 8" BLOCK;
            CheckRule "$TRAVERSAL >= 4" BLOCK;
            CheckRule "$EVADE >= 4" BLOCK;
            CheckRule "$UPLOAD >= 8" BLOCK;
            CheckRule "$XSS >= 8" BLOCK;
            include /usr/local/etc/nginx/naxsi/ha_whitelist.rules;

            proxy_pass http://192.168.1.11:8123;
            proxy_set_header Host $host;
            proxy_http_version 1.1;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "Upgrade";
            more_set_headers "X-Frame-Options : always";
	    more_set_headers "Content-Security-Policy : default-src https: data: 'unsafe-inline' 'unsafe-eval' always; connect-src https: wss: 'self'" always";
        }

        location / {
            proxy_pass http://192.168.1.11:8123;
            proxy_set_header Host $host;
            proxy_http_version 1.1;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "Upgrade";
            more_set_headers "X-Frame-Options : always";
	    more_set_headers "Content-Security-Policy : default-src https: data: 'unsafe-inline' 'unsafe-eval' always; connect-src https: wss: 'self'" always";

        }

        location /api/websocket {
            proxy_pass http://192.168.1.11:8123/api/websocket;
            proxy_set_header Host $host;
            proxy_http_version 1.1;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            more_set_headers "X-Frame-Options : always";
            more_set_headers "Content-Security-Policy : default-src https: data: 'unsafe-inline' 'unsafe-eval' always; connect-src https: wss: 'self'" always";
        }
}
