server {
    listen 443 ssl;
        http2 on;
    server_name files.nicolas-simond.ch;

    # SSL configuration...
        ssl_certificate /etc/letsencrypt/live/nicolas-simond.ch/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/nicolas-simond.ch/privkey.pem;

        error_log /var/log/nginx/files.nicolas-simond.ch/error.log;
        NaxsiLogFile /var/log/nginx/files.nicolas-simond.ch/naxsi_error.log;
        access_log /var/log/nginx/files.nicolas-simond.ch/access.log combined;
        # Higher than other vhosts: a single Nextcloud page load fans
        # out into dozens of small per-app JS chunk requests (files,
        # text, notifications...) on top of any concurrent desktop/
        # mobile sync client traffic - 100 was already hit on plain
        # page loads (error_log: "limiting connections by zone
        # \"conn_nextcloud\"").
        limit_conn conn_nextcloud 800;

        include /usr/local/etc/nginx/naxsi/naxsi_denied.conf;

        # WebDAV sync/CalDAV/CardDAV (desktop/mobile clients, file sync):
        # PROPFIND/PUT bodies are raw XML, incompatible with generic
        # naxsi scoring (XML tags alone trip $XSS instantly, same
        # reasoning as WordPress's xmlrpc.php). No naxsi here.
        location ~ ^/(remote|public)\.php/(web)?dav {
            client_max_body_size 512M;
            proxy_ssl_server_name on;
            proxy_ssl_session_reuse on;
            proxy_pass https://192.168.1.10:443;
            proxy_set_header Connection $http_connection;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location / {
        client_max_body_size 512M;

        # Naxsi WAF - core rules, standard thresholds, on the web UI/
        # login/sharing/OCS API. No community whitelist exists for
        # Nextcloud - watch for false positives, particularly on the
        # OCS share/API endpoints.
        SecRulesEnabled;
        CheckRule "$SQL >= 8" BLOCK;
        CheckRule "$RFI >= 8" BLOCK;
        CheckRule "$TRAVERSAL >= 4" BLOCK;
        CheckRule "$EVADE >= 4" BLOCK;
        CheckRule "$UPLOAD >= 8" BLOCK;
        CheckRule "$XSS >= 8" BLOCK;
        include /usr/local/etc/nginx/naxsi/nextcloud_whitelist.rules;

                proxy_ssl_server_name on;
        proxy_ssl_session_reuse on;
        proxy_pass https://192.168.1.10:443;
        proxy_set_header Connection $http_connection;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
